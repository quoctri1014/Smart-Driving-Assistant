<mxfile host="app.diagrams.net" modified="2026-10-03T00:00:00.000Z" agent="TrafficGuard" version="22.0.0" type="device">
  <diagram id="dual_stream_pipeline" name="Dual Stream Pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Sơ đồ Luồng Xử lý Song song 2 Kênh Camera (Dual Stream Pipeline)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="250" y="30" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_road" value="&lt;b&gt;&lt;font color=&quot;#1d4ed8&quot; style=&quot;font-size: 14px;&quot;&gt;LUỒNG ROAD-FACING (MẶT ĐƯỜNG)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b_road" value="&lt;div style=&quot;text-align: left; line-height: 160%; font-size: 12px;&quot;&gt;1. Thu nhận Frame 1080p&lt;br&gt;2. ROI Crop (Bỏ 30% trời)&lt;br&gt;3. YOLOv8 Phát hiện xe&lt;br&gt;4. MOT Bám vết (IoU/Kalman)&lt;br&gt;5. Homography tính Vận tốc&lt;br&gt;6. Biển báo QCVN 41 &amp;amp; S.508&lt;br&gt;7. Cự ly an toàn (TT31) &amp;amp; TTC&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#2563eb;strokeWidth=2;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="b_core" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#15803d&quot; style=&quot;font-size: 14px;&quot;&gt;FASTAPI BACKEND CORE&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; line-height: 150%; font-size: 11px;&quot;&gt;• WebSocket Server (ws/stream)&lt;br&gt;• In-Memory Frame Processing&lt;br&gt;&amp;nbsp;&amp;nbsp;- Priority Decision Engine&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ Mức 1: CRITICAL (TTC/Sleep)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ Mức 2: WARNING (Speed/Dist)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;+ Mức 3: INFO (Seatbelt/Rest)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Debounce Filter (Chống dội)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Privacy Blur &amp;amp; Hash SHA-256&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=2;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="410" y="145" width="280" height="230" as="geometry" />
        </mxCell>
        <mxCell id="t_cabin" value="&lt;b&gt;&lt;font color=&quot;#6d28d9&quot; style=&quot;font-size: 14px;&quot;&gt;LUỒNG DRIVER-FACING (CABIN DMS)&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="740" y="90" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b_cabin" value="&lt;div style=&quot;text-align: left; line-height: 160%; font-size: 12px;&quot;&gt;1. Thu nhận Frame Cabin&lt;br&gt;2. MediaPipe 468 Face Mesh&lt;br&gt;3. Dynamic Calibration EAR&lt;br&gt;4. Tính EAR (Mắt) &amp;amp; MAR (Miệng)&lt;br&gt;5. Cửa sổ PERCLOS 60s&lt;br&gt;6. 3D Head Pose (solvePnP)&lt;br&gt;7. Dây an toàn &amp;amp; Đếm giờ 4h&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="arr1" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#2563eb;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_road" target="b_core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr2" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#7c3aed;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_cabin" target="b_core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_out" value="&lt;b&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 13px;&quot;&gt;Đồng bộ đầu ra: Web Dashboard (Canvas 60fps) + Mobile App HUD + Còi Web Audio &amp;amp; Giọng nói tiếng Việt&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="440" width="800" height="50" as="geometry" />
