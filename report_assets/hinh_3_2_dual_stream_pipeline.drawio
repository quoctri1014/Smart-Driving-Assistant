        <mxCell id="arr3" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d97706;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_core" target="b_out">
